# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est jamais commité.

# Base PostgreSQL (fournie en local par `docker compose up -d`)
DATABASE_URL=postgres://sourcee:sourcee@localhost:5432/sourcee
# Base séparée pour les tests d'intégration (créée au premier démarrage du conteneur)
DATABASE_URL_TEST=postgres://sourcee:sourcee@localhost:5432/sourcee_test

# Clé de l'API Claude (Anthropic), utilisée uniquement pour les résumés
ANTHROPIC_API_KEY=
# Modèle utilisé pour les résumés
SUMMARY_MODEL=claude-haiku-5-5

# Identifiant envoyé aux sites pendant la collecte.
# Conseillé : un nom et une URL de contact, par exemple « MonProjet/0.1 (+https://exemple.org) ».
COLLECTOR_USER_AGENT=

# Port de l'API REST
API_PORT=3000
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules
# (inutile en développement : le serveur Vite relaie /api)
CORS_ORIGINS=
